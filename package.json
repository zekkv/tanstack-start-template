{
  "name": "tanstack-start-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "clean": "bunx rimraf .output .vite node_modules .tanstack src/routeTree.gen.ts coverage test-results playwright-report",
    "dev": "cross-env NODE_OPTIONS=--import=./instrument.server.mjs vite dev --port 3000",
    "build": "vite build",
    "build:docker": "docker build -t tanstack-start-template .",
    "preview": "vite preview",
    "start": "bun --import ./instrument.server.mjs .output/server/index.mjs",
    "type:check": "tsc --noEmit",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "auth:generate": "bunx auth@latest generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "codegen": "playwright codegen",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-presigned-post": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/passkey": "^1.6.26",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@logtape/logtape": "^2.3.0",
    "@logtape/sentry": "^2.3.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/tanstackstart-react": "^10.69.0",
    "@shadcn/react": "^0.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-form-start": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.40",
    "@tanstack/react-table": "^9.1.0",
    "@tanstack/router-plugin": "^1.168.27",
    "@upstash/redis": "^1.38.2",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "1.30.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260610-beta",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-form-devtools": "^0.2.32",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/instrumentation": "0.214.0"
  },
  "packageManager": "bun@1.3.14"
}
